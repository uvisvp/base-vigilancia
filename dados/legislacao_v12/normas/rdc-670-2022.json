    },
    {
      "id": "rdc-670-2022::bloco::b18",
      "norma": "RDC 670-2022",
      "anexo": null,
      "tipo": "bloco",
      "numero": "b18",
      "rotulo": "Texto",
      "texto": "Dispõe sobre os requisitos mínimos para garantir a qualidade dos medicamentos importados.",
      "ordem": 18,
      "estrutural": false,
      "status_vigencia": "vigente"
    },
    {
      "id": "rdc-670-2022::bloco::b19",
      "norma": "RDC 670-2022",
      "anexo": null,
      "tipo": "bloco",
      "numero": "b19",
      "rotulo": "Texto",
      "texto": "A Diretoria Colegiada da Agência Nacional de Vigilância Sanitária, no uso das atribuições que lhe confere o",
      "ordem": 19,
      "estrutural": false,
      "status_vigencia": "vigente"
    },
    {
      "id": "rdc-670-2022::artigo::15",
