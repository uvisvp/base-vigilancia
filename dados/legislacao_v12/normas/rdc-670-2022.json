    },
    {
      "id": "rdc-670-2022::artigo::187",
      "norma": "RDC 670-2022",
      "anexo": null,
      "tipo": "artigo",
      "numero": "187",
      "rotulo": "Art. 187",
      "texto": "art. 187, VI, § 1º do Regimento Interno aprovado pela Resolução de Diretoria Colegiada - RDC nº 585, de 10 de dezembro de 2021",
      "ordem": 22,
      "ocorrencia": 1,
      "status_vigencia": "vigente"
    },
    {
      "id": "rdc-670-2022::bloco::b23",
      "norma": "RDC 670-2022",
      "anexo": null,
      "tipo": "bloco",
      "numero": "b23",
      "rotulo": "Texto",
      "texto": ", resolve adotar a seguinte Resolução, conforme deliberado em Reunião Extraordinária - RExtra nº 6, realizada em 30 de março de 2022, e eu, Diretor-Presidente, determino a sua publicação.",
      "ordem": 23,
      "pai": "rdc-670-2022::artigo::187",
      "estrutural": false,
      "status_vigencia": "vigente"
    },
    {
      "id": "rdc-670-2022::bloco::b24",
      "norma": "RDC 670-2022",
      "anexo": null,
      "tipo": "bloco",
      "numero": "b24",
      "rotulo": "Texto",
      "texto": "CAPÍTULO I",
      "ordem": 24,
      "pai": "rdc-670-2022::artigo::187",
      "estrutural": false,
      "status_vigencia": "vigente"
    },
    {
      "id": "rdc-670-2022::bloco::b25",
      "norma": "RDC 670-2022",
      "anexo": null,
      "tipo": "bloco",
      "numero": "b25",
      "rotulo": "Texto",
      "texto": "DISPOSIÇÕES INICIAIS",
      "ordem": 25,
      "pai": "rdc-670-2022::artigo::187",
      "estrutural": false,
      "status_vigencia": "vigente"
    },
    {
      "id": "rdc-670-2022::bloco::b26",
      "norma": "RDC 670-2022",
