{"schema":"legislacao-hierarquica-v12","norma":"Lei 9965-2000","sha256_texto":"02a55609146822d29a4e225fdf05b700958670909b8646b7456dca47c93d8144","nos":[{"id":"lei-9965-2000::bloco::b1","norma":"Lei 9965-2000","anexo":null,"tipo":"bloco","numero":"b1","rotulo":"Texto","texto":"Presidência da República","ordem":1,"estrutural":false,"status_vigencia":"vigente"},{"id":"lei-9965-2000::bloco::b2","norma":"Lei 9965-2000","anexo":null,"tipo":"bloco","numero":"b2","rotulo":"Texto","texto":"Casa Civil","ordem":2,"estrutural":false,"status_vigencia":"vigente"},{"id":"lei-9965-2000::bloco::b3","norma":"Lei 9965-2000","anexo":null,"tipo":"bloco","numero":"b3","rotulo":"Texto","texto":"Subchefia para Assuntos Jurídicos","ordem":3,"estrutural":false,"status_vigencia":"vigente"},{"id":"lei-9965-2000::bloco::b4","norma":"Lei 9965-2000","anexo":null,"tipo":"bloco","numero":"b4","rotulo":"Texto","texto":"LEI No 9.965, DE 27 DE ABRIL DE 2000.","ordem":4,"estrutural":false,"status_vigencia":"vigente"},{"id":"lei-9965-2000::bloco::b5","norma":"Lei 9965-2000","anexo":null,"tipo":"bloco","numero":"b5","rotulo":"Texto","texto":"Restringe a venda de esteróides ou peptídeos anabolizantes e dá outras providências.","ordem":5,"estrutural":false,"status_vigencia":"vigente"},{"id":"lei-9965-2000::bloco::b6","norma":"Lei 9965-2000","anexo":null,"tipo":"bloco","numero":"b6","rotulo":"Texto","texto":"O PRESIDENTE DA REPÚBLICA Faço saber que o Congresso Nacional decreta e eu sanciono a seguinte Lei:","ordem":6,"estrutural":false,"status_vigencia":"vigente"},{"id":"lei-9965-2000::artigo::1","norma":"Lei 9965-2000","anexo":null,"tipo":"artigo","numero":"1","rotulo":"Art. 1","texto":"Art. 1o A dispensação ou a venda de medicamentos do grupo terapêutico dos esteróides ou peptídeos anabolizantes para uso humano estarão restritas à apresentação e retenção, pela farmácia ou drogaria, da cópia carbonada de receita emitida por médico ou dentista devidamente registrados nos respectivos conselhos profissionais.","ordem":7,"ocorrencia":1,"status_vigencia":"vigente"},{"id":"lei-9965-2000::artigo::1::paragrafo::unico","norma":"Lei 9965-2000","anexo":null,"tipo":"paragrafo","numero":"unico","rotulo":"Parágrafo único","texto":"Parágrafo único. A receita de que trata este artigo deverá conter a identificação do profissional, o número de registro no respectivo conselho profissional (CRM ou CRO), o número do Cadastro da Pessoa Física (CPF), o endereço e telefone profissionais, além do nome, do endereço do paciente e do número do Código Internacional de Doenças (CID), devendo a mesma ficar retida no estabelecimento farmacêutico por cinco anos.","ordem":8,"pai":"lei-9965-2000::artigo::1","status_vigencia":"vigente"},{"id":"lei-9965-2000::artigo::2","norma":"Lei 9965-2000","anexo":null,"tipo":"artigo","numero":"2","rotulo":"Art. 2","texto":"Art. 2o A inobservância do disposto nesta Lei configurará infração sanitária, estando o infrator sujeito ao processo e penalidades previstos na Lei no 6.437, de 20 de agosto de 1977, sem prejuízo das demais sanções civis ou penais.","ordem":9,"ocorrencia":1,"status_vigencia":"vigente"},{"id":"lei-9965-2000::artigo::3","norma":"Lei 9965-2000","anexo":null,"tipo":"artigo","numero":"3","rotulo":"Art. 3","texto":"Art. 3o A União, os Estados, o Distrito Federal e os Municípios poderão celebrar convênios para a fiscalização e o controle da observância desta Lei.","ordem":10,"ocorrencia":1,"status_vigencia":"vigente"},{"id":"lei-9965-2000::artigo::4","norma":"Lei 9965-2000","anexo":null,"tipo":"artigo","numero":"4","rotulo":"Art. 4","texto":"Art. 4o Esta Lei entra em vigor na data de sua publicação.","ordem":11,"ocorrencia":1,"status_vigencia":"vigente"},{"id":"lei-9965-2000::bloco::b12","norma":"Lei 9965-2000","anexo":null,"tipo":"bloco","numero":"b12","rotulo":"Texto","texto":"Brasília, 27 de abril de 2000; 179o da Independência e 112o da República.","ordem":12,"pai":"lei-9965-2000::artigo::4","estrutural":false,"status_vigencia":"vigente"},{"id":"lei-9965-2000::bloco::b13","norma":"Lei 9965-2000","anexo":null,"tipo":"bloco","numero":"b13","rotulo":"Texto","texto":"FERNANDO HENRIQUE CARDOSO","ordem":13,"pai":"lei-9965-2000::artigo::4","estrutural":false,"status_vigencia":"vigente"},{"id":"lei-9965-2000::bloco::b14","norma":"Lei 9965-2000","anexo":null,"tipo":"bloco","numero":"b14","rotulo":"Texto","texto":"José Gregori","ordem":14,"pai":"lei-9965-2000::artigo::4","estrutural":false,"status_vigencia":"vigente"},{"id":"lei-9965-2000::bloco::b15","norma":"Lei 9965-2000","anexo":null,"tipo":"bloco","numero":"b15","rotulo":"Texto","texto":"José Serra","ordem":15,"pai":"lei-9965-2000::artigo::4","estrutural":false,"status_vigencia":"vigente"},{"id":"lei-9965-2000::bloco::b16","norma":"Lei 9965-2000","anexo":null,"tipo":"bloco","numero":"b16","rotulo":"Texto","texto":"Este texto não substitui o publicado no D.O.U de 28.4.2000","ordem":16,"pai":"lei-9965-2000::artigo::4","estrutural":false,"status_vigencia":"vigente"},{"id":"lei-9965-2000::bloco::b17","norma":"Lei 9965-2000","anexo":null,"tipo":"bloco","numero":"b17","rotulo":"Texto","texto":"*","ordem":17,"pai":"lei-9965-2000::artigo::4","estrutural":false,"status_vigencia":"vigente"}],"validacao":{"ids_estruturais_repetidos":[],"artigos_repetidos_na_fonte":{}},"proveniencia":{"norma":"Lei 9965-2000","fonte_oficial":"https://www.planalto.gov.br/ccivil_03/leis/l9965.htm","consultado_em":"2026-09-06T00:56:39.706708+00:00","data_fonte":"2000-04-27","tipo_data_fonte":"data_do_ato; consolidação sem data oficial declarada","sha256_fonte":"827daf94612ee605c5f5a98c8ef3d2ad98f656afdeae41432bf3355afd6a7885","sha256_texto":"02a55609146822d29a4e225fdf05b700958670909b8646b7456dca47c93d8144","alteracoes_encontradas":[],"status_vigencia":"vigente","texto":"textos\\Lei 9965-2000--oficial.txt","data_processamento":"2026-09-06T00:58:23.606157+00:00","schema":"proveniencia-legislativa-v1","estruturar_alineas":true,"escopo_validacao":"dispositivos vinculados ao roteiro de drogaria; anexos e demais usos exigem revisão própria"}}
