{"schema":"legislacao-hierarquica-v12","norma":"RDC 1028-2026","sha256_texto":"31719b844ee786344a75d3aec0aa1daae9e94baf8ce42ff6138e8815fe130e39","nos":[{"id":"rdc-1028-2026::bloco::b1","norma":"RDC 1028-2026","anexo":null,"tipo":"bloco","numero":"b1","rotulo":"Texto","texto":"MINISTÉRIO DA SAÚDE","ordem":1,"estrutural":false,"status_vigencia":"vigente"},{"id":"rdc-1028-2026::bloco::b2","norma":"RDC 1028-2026","anexo":null,"tipo":"bloco","numero":"b2","rotulo":"Texto","texto":"AGÊNCIA NACIONAL DE VIGILÂNCIA SANITÁRIA","ordem":2,"estrutural":false,"status_vigencia":"vigente"},{"id":"rdc-1028-2026::bloco::b3","norma":"RDC 1028-2026","anexo":null,"tipo":"bloco","numero":"b3","rotulo":"Texto","texto":"DIRETORIA COLEGIADA","ordem":3,"estrutural":false,"status_vigencia":"vigente"},{"id":"rdc-1028-2026::bloco::b4","norma":"RDC 1028-2026","anexo":null,"tipo":"bloco","numero":"b4","rotulo":"Texto","texto":"RESOLUÇÃO DA DIRETORIA COLEGIADA ANVISA Nº 1.028, DE 1° DE JUNHO DE 2026","ordem":4,"estrutural":false,"status_vigencia":"vigente"},{"id":"rdc-1028-2026::bloco::b5","norma":"RDC 1028-2026","anexo":null,"tipo":"bloco","numero":"b5","rotulo":"Texto","texto":"Altera a Resolução da Diretoria Colegiada nº 1.000, de 11 de dezembro de 2025, que dispõe sobre os requisitos de controle para Notificações de Receita, Receitas de Controle Especial e Receitas sujeitas à retenção emitidas em meio eletrônico.","ordem":5,"estrutural":false,"status_vigencia":"vigente"},{"id":"rdc-1028-2026::bloco::b6","norma":"RDC 1028-2026","anexo":null,"tipo":"bloco","numero":"b6","rotulo":"Texto","texto":"A DIRETORIA COLEGIADA DA AGÊNCIA NACIONAL DE VIGILÂNCIA SANITÁRIA, no uso da atribuição que lhe confere o art. 15, III e IV, aliado ao art. 7º, III, e IV, da Lei nº 9.782, de 26 de janeiro de 1999, e ao art. 187, VI, § 1º do Regimento Interno aprovado pela Resolução da Diretoria Colegiada - RDC nº 585, de 10 de dezembro de 2021, resolve adotar a seguinte Resolução da Diretoria Colegiada, conforme deliberado em reunião realizada em 27 de maio de 2026, e eu, Diretor-Presidente, determino a sua publicação.","ordem":6,"estrutural":false,"status_vigencia":"vigente"},{"id":"rdc-1028-2026::artigo::1","norma":"RDC 1028-2026","anexo":null,"tipo":"artigo","numero":"1","rotulo":"Art. 1","texto":"Art. 1º A Resolução da Diretoria Colegiada - RDC nº 1.000, de 11 de dezembro de 2025, publicada no Diário Oficial da União nº 238, de 15 de dezembro de 2025, Seção 1, pág. 174, passa a vigorar com as seguintes alterações:","ordem":7,"ocorrencia":1,"status_vigencia":"vigente"},{"id":"rdc-1028-2026::bloco::b8","norma":"RDC 1028-2026","anexo":null,"tipo":"bloco","numero":"b8","rotulo":"Texto","texto":"\"Art. 5º .....................................................................................................................","ordem":8,"pai":"rdc-1028-2026::artigo::1","estrutural":false,"status_vigencia":"vigente"},{"id":"rdc-1028-2026::artigo::1::inciso::i","norma":"RDC 1028-2026","anexo":null,"tipo":"inciso","numero":"I","rotulo":"Inciso I","texto":"I - requisitar ao SNCR a numeração necessária à emissão dos receituários eletrônicos;","ordem":9,"pai":"rdc-1028-2026::artigo::1","status_vigencia":"vigente"},{"id":"rdc-1028-2026::bloco::b10","norma":"RDC 1028-2026","anexo":null,"tipo":"bloco","numero":"b10","rotulo":"Texto","texto":"...................................................................................................................................\"","ordem":10,"pai":"rdc-1028-2026::artigo::1::inciso::i","estrutural":false,"status_vigencia":"vigente"},{"id":"rdc-1028-2026::bloco::b11","norma":"RDC 1028-2026","anexo":null,"tipo":"bloco","numero":"b11","rotulo":"Texto","texto":"\"Art. 16. A Anvisa disponibilizará o SNCR para a requisição de numeração para a emissão eletrônica dos receituários eletrônicos de que trata esta Resolução, bem como o respectivo registro de utilização, até 30 de setembro de 2026.\" (NR)","ordem":11,"pai":"rdc-1028-2026::artigo::1::inciso::i","estrutural":false,"status_vigencia":"vigente"},{"id":"rdc-1028-2026::artigo::2","norma":"RDC 1028-2026","anexo":null,"tipo":"artigo","numero":"2","rotulo":"Art. 2","texto":"Art. 2 º Esta Resolução entra em vigor na data de sua publicação.","ordem":12,"ocorrencia":1,"status_vigencia":"vigente"},{"id":"rdc-1028-2026::bloco::b13","norma":"RDC 1028-2026","anexo":null,"tipo":"bloco","numero":"b13","rotulo":"Texto","texto":"LEANDRO PINHEIRO SAFATLE","ordem":13,"pai":"rdc-1028-2026::artigo::2","estrutural":false,"status_vigencia":"vigente"},{"id":"rdc-1028-2026::bloco::b14","norma":"RDC 1028-2026","anexo":null,"tipo":"bloco","numero":"b14","rotulo":"Texto","texto":"Diretor-Presidente","ordem":14,"pai":"rdc-1028-2026::artigo::2","estrutural":false,"status_vigencia":"vigente"},{"id":"rdc-1028-2026::bloco::b15","norma":"RDC 1028-2026","anexo":null,"tipo":"bloco","numero":"b15","rotulo":"Texto","texto":"PUB D.O.U., 02/06/2026 - Seção 1","ordem":15,"pai":"rdc-1028-2026::artigo::2","estrutural":false,"status_vigencia":"vigente"},{"id":"rdc-1028-2026::bloco::b16","norma":"RDC 1028-2026","anexo":null,"tipo":"bloco","numero":"b16","rotulo":"Texto","texto":"Este texto não substitui a Publicação Oficial.","ordem":16,"pai":"rdc-1028-2026::artigo::2","estrutural":false,"status_vigencia":"vigente"}],"validacao":{"ids_estruturais_repetidos":[],"artigos_repetidos_na_fonte":{}},"proveniencia":{"norma":"RDC 1028-2026","fonte_oficial":"https://anvisalegis.datalegis.net/action/ActionDatalegis.php?acao=abrirTextoAto&cod_menu=8542&cod_modulo=310&link=S&numeroAto=00001028&orgao=RDC%2FDC%2FANVISA%2FMS&seqAto=000&tipo=RDC&valorAno=2026","consultado_em":"2026-09-06T00:56:39.329358+00:00","data_fonte":"2026-06-01","tipo_data_fonte":"data_do_ato; consolidação sem data oficial declarada","sha256_fonte":"8286c2e25904fe82034a52e7747b6324049e4df55bee3dcccb8d67d3682622e0","sha256_texto":"31719b844ee786344a75d3aec0aa1daae9e94baf8ce42ff6138e8815fe130e39","alteracoes_encontradas":[],"status_vigencia":"vigente","texto":"textos\\RDC 1028-2026--oficial.txt","data_processamento":"2026-09-06T00:58:23.593467+00:00","schema":"proveniencia-legislativa-v1","estruturar_alineas":true,"escopo_validacao":"dispositivos vinculados ao roteiro de drogaria; anexos e demais usos exigem revisão própria"}}
