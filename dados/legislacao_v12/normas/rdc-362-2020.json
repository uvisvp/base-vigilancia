      "texto": "Resolução de Diretoria Colegiada - RDC nº 359, de 27 de março de 2020",
      "ordem": 72,
      "pai": "rdc-362-2020::artigo::12",
      "estrutural": false,
      "status_vigencia": "revogada_2022-05-02"
    },
    {
      "id": "rdc-362-2020::bloco::b73",
      "norma": "RDC 362-2020",
      "anexo": null,
      "tipo": "bloco",
      "numero": "b73",
      "rotulo": "Texto",
      "texto": "ou registro de IFA em análise na ANVISA, nos termos da",
      "ordem": 73,
      "pai": "rdc-362-2020::artigo::12",
      "estrutural": false,
      "status_vigencia": "revogada_2022-05-02"
    },
    {
