      "anexo": null,
      "tipo": "bloco",
      "numero": "b80",
      "rotulo": "Texto",
      "texto": "Lei nº. 6.437, de 20 de agosto de 1977",
      "ordem": 80,
      "pai": "rdc-672-2022::artigo::11",
      "estrutural": false,
      "status_vigencia": "vigente"
    },
    {
      "id": "rdc-672-2022::bloco::b81",
      "norma": "RDC 672-2022",
      "anexo": null,
      "tipo": "bloco",
      "numero": "b81",
      "rotulo": "Texto",
      "texto": ", sem prejuízo das responsabilidades civil, administrativa e penal cabíveis.",
      "ordem": 81,
      "pai": "rdc-672-2022::artigo::11",
      "estrutural": false,
      "status_vigencia": "vigente"
    },
    {
