      "tipo": "artigo",
      "numero": "15",
      "rotulo": "Art. 15",
      "texto": "art. 15, III e IV, aliado ao art. 7º, III e IV, da Lei nº 9.782, de 26 de janeiro de 1999",
      "ordem": 20,
      "ocorrencia": 1,
      "status_vigencia": "vigente"
    },
    {
