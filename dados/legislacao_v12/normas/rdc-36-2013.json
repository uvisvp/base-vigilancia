    {
      "id": "rdc-36-2013::artigo::12",
      "norma": "RDC 36-2013",
      "anexo": null,
      "tipo": "artigo",
      "numero": "12",
      "rotulo": "Art. 12",
      "texto": "Art. 12 Os serviços de saúde abrangidos por esta Resolução terão o prazo de 180 (cento e oitenta) dias para a estruturação dos NSP e elaboração do PSP e o prazo de 210 (duzentos e dez) dias para iniciar a notificação mensal dos eventos adversos, contados a partir da data da publicação desta Resolução.(Redação dada pela Resolução 53/2013)",
      "ordem": 104,
      "ocorrencia": 1,
      "status_vigencia": "vigente"
    },
    {
