    {
      "id": "rdc-653-2022::artigo::89",
      "norma": "RDC 653-2022",
      "anexo": null,
      "tipo": "artigo",
      "numero": "89",
      "rotulo": "Art. 89",
      "texto": "Art. 89",
      "ordem": 39,
      "ocorrencia": 1,
      "status_vigencia": "vigente"
    },
    {
      "id": "rdc-653-2022::bloco::b40",
      "norma": "RDC 653-2022",
      "anexo": null,
      "tipo": "bloco",
      "numero": "b40",
      "rotulo": "Texto",
      "texto": "- Fica estabelecido o prazo de 3 (três) anos a partir da data de entrada em vigor desta Resolução para a aplicação do conjunto de ações que serão necessárias à implementação do requerido nos incisos II e III do art. 64.",
      "ordem": 40,
      "pai": "rdc-653-2022::artigo::89",
      "estrutural": false,
      "status_vigencia": "vigente"
    },
    {
      "id": "rdc-653-2022::artigo::89::paragrafo::1",
      "norma": "RDC 653-2022",
      "anexo": null,
      "tipo": "paragrafo",
      "numero": "1",
      "rotulo": "§ 1º",
      "texto": "§ 1º Fica estabelecido o prazo de 2 (dois) anos a partir da data de entrada em vigor desta Resolução para que todos os elos da cadeia de distribuição realizem seus estudos de mapeamento de rotas.",
      "ordem": 41,
      "pai": "rdc-653-2022::artigo::89",
      "status_vigencia": "vigente"
    },
    {
      "id": "rdc-653-2022::artigo::89::paragrafo::2",
      "norma": "RDC 653-2022",
      "anexo": null,
      "tipo": "paragrafo",
      "numero": "2",
      "rotulo": "§ 2º",
      "texto": "§ 2º Após o prazo estabelecido no §1º as empresas terão 1 (hum) ano para a implementação das soluções aplicáveis levando em consideração os resultados obtidos nos estudos de mapeamento de rotas ou nas análises de risco.\" (NR)",
      "ordem": 42,
      "pai": "rdc-653-2022::artigo::89",
      "status_vigencia": "vigente"
    },
    {
      "id": "rdc-653-2022::artigo::89::paragrafo::3",
      "norma": "RDC 653-2022",
      "anexo": null,
      "tipo": "paragrafo",
      "numero": "3",
      "rotulo": "§ 3º",
      "texto": "§ 3º .........................................................\" (NR)",
      "ordem": 43,
      "pai": "rdc-653-2022::artigo::89",
      "status_vigencia": "vigente"
    },
