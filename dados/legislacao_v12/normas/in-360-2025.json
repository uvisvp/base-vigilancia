{"schema":"legislacao-hierarquica-v12","norma":"IN 360-2025","sha256_texto":"bb6f0cbfdd55d8e656f21afc6aabecf765a1faa660aa6843df025100a138b44e","nos":[{"id":"in-360-2025::bloco::b1","norma":"IN 360-2025","anexo":null,"tipo":"bloco","numero":"b1","rotulo":"Texto","texto":"MINISTÉRIO DA SAÚDE","ordem":1,"estrutural":false,"status_vigencia":"vigente"},{"id":"in-360-2025::bloco::b2","norma":"IN 360-2025","anexo":null,"tipo":"bloco","numero":"b2","rotulo":"Texto","texto":"AGÊNCIA NACIONAL DE VIGILÂNCIA SANITÁRIA","ordem":2,"estrutural":false,"status_vigencia":"vigente"},{"id":"in-360-2025::bloco::b3","norma":"IN 360-2025","anexo":null,"tipo":"bloco","numero":"b3","rotulo":"Texto","texto":"DIRETORIA COLEGIADA","ordem":3,"estrutural":false,"status_vigencia":"vigente"},{"id":"in-360-2025::bloco::b4","norma":"IN 360-2025","anexo":null,"tipo":"bloco","numero":"b4","rotulo":"Texto","texto":"INSTRUÇÃO NORMATIVA-IN Nº 360, DE 23 DE ABRIL DE 2025","ordem":4,"estrutural":false,"status_vigencia":"vigente"},{"id":"in-360-2025::bloco::b5","norma":"IN 360-2025","anexo":null,"tipo":"bloco","numero":"b5","rotulo":"Texto","texto":"Define a lista de substâncias isoladas ou em associação utilizadas em medicamentos de uso sob prescrição e retenção da receita, de que trata a Resolução de Diretoria Colegiada - RDC nº 471, de 23 de fevereiro de 2021.","ordem":5,"estrutural":false,"status_vigencia":"vigente"},{"id":"in-360-2025::bloco::b6","norma":"IN 360-2025","anexo":null,"tipo":"bloco","numero":"b6","rotulo":"Texto","texto":"A DIRETORIA COLEGIADA DA AGÊNCIA NACIONAL DE VIGILÂNCIA SANITÁRIA, no uso da atribuição que lhe confere o art. 15, III e IV, aliado ao art. 7º, III da Lei n° 9.782, de 26 de janeiro de 1999, e ao art. 187, VII, § 1º do Regimento Interno aprovado pela Resolução da Diretoria Colegiada - RDC n° 585, de 10 de dezembro de 2021, resolve adotar a seguinte Instrução Normativa, conforme deliberado em reunião realizada em 16 de abril de 2025, e eu, Diretor-Presidente Substituto, determino a sua publicação.","ordem":6,"estrutural":false,"status_vigencia":"vigente"},{"id":"in-360-2025::artigo::1","norma":"IN 360-2025","anexo":null,"tipo":"artigo","numero":"1","rotulo":"Art. 1","texto":"Art. 1º Fica definida a lista de substâncias classificadas como antimicrobianos de uso sob prescrição, isoladas ou em associação, de que trata a Resolução da Diretoria Colegiada - RDC nº 471, de 23 de fevereiro de 2021, publicada no Diário Oficial da União nº 36, de 24 de fevereiro de 2021, seção 1, pág. 85:","ordem":7,"ocorrencia":1,"status_vigencia":"vigente"},{"id":"in-360-2025::artigo::1::item::1","norma":"IN 360-2025","anexo":null,"tipo":"item","numero":"1","rotulo":"Item 1","texto":"1 - ácido clavulânico;","ordem":8,"pai":"in-360-2025::artigo::1","status_vigencia":"vigente"},{"id":"in-360-2025::artigo::1::item::2","norma":"IN 360-2025","anexo":null,"tipo":"item","numero":"2","rotulo":"Item 2","texto":"2 - ácido fusídico;","ordem":9,"pai":"in-360-2025::artigo::1","status_vigencia":"vigente"},{"id":"in-360-2025::artigo::1::item::3","norma":"IN 360-2025","anexo":null,"tipo":"item","numero":"3","rotulo":"Item 3","texto":"3 - ácido nalidíxico;","ordem":10,"pai":"in-360-2025::artigo::1","status_vigencia":"vigente"},{"id":"in-360-2025::artigo::1::item::4","norma":"IN 360-2025","anexo":null,"tipo":"item","numero":"4","rotulo":"Item 4","texto":"4 - ácido oxolínico;","ordem":11,"pai":"in-360-2025::artigo::1","status_vigencia":"vigente"},{"id":"in-360-2025::artigo::1::item::5","norma":"IN 360-2025","anexo":null,"tipo":"item","numero":"5","rotulo":"Item 5","texto":"5 - ácido pipemídico;","ordem":12,"pai":"in-360-2025::artigo::1","status_vigencia":"vigente"},{"id":"in-360-2025::artigo::1::item::6","norma":"IN 360-2025","anexo":null,"tipo":"item","numero":"6","rotulo":"Item 6","texto":"6 - amicacina;","ordem":13,"pai":"in-360-2025::artigo::1","status_vigencia":"vigente"},{"id":"in-360-2025::artigo::1::item::7","norma":"IN 360-2025","anexo":null,"tipo":"item","numero":"7"