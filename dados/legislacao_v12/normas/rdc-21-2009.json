{"schema":"legislacao-hierarquica-v12","norma":"RDC 21-2009","sha256_texto":"e25514901b9b17d7000384b3a93e0c37f3192c5a43804d9d4729949623eec253","nos":[{"id":"rdc-21-2009::bloco::b1","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b1","rotulo":"Texto","texto":"Resolução da Diretoria Colegiada - RDC nº 21, de 20/05/2009","ordem":1,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b2","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b2","rotulo":"Texto","texto":"Voltar","ordem":2,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b3","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b3","rotulo":"Texto","texto":"COPIAR LINK","ordem":3,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b4","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b4","rotulo":"Texto","texto":"CRIAR TAGS","ordem":4,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b5","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b5","rotulo":"Texto","texto":"IMPRIMIR","ordem":5,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b6","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b6","rotulo":"Texto","texto":"PDF","ordem":6,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b7","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b7","rotulo":"Texto","texto":"VER NOTAS DE ALTERAÇÃO","ordem":7,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b8","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b8","rotulo":"Texto","texto":"FECHAR NOTAS DE ALTERAÇÃO","ordem":8,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b9","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b9","rotulo":"Texto","texto":"+","ordem":9,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b10","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b10","rotulo":"Texto","texto":"|","ordem":10,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b11","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b11","rotulo":"Texto","texto":"-","ordem":11,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b12","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b12","rotulo":"Texto","texto":"Alterador","ordem":12,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b13","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b13","rotulo":"Texto","texto":"Resolução da Diretoria Colegiada - RDC nº 21, de 20/05/2009","ordem":13,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b14","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b14","rotulo":"Texto","texto":"Ver mais detalhes","ordem":14,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b15","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b15","rotulo":"Texto","texto":"MINISTÉRIO DA SAÚDE","ordem":15,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b16","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b16","rotulo":"Texto","texto":"AGÊNCIA NACIONAL DE VIGILÂNCIA SANITÁRIA","ordem":16,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b17","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b17","rotulo":"Texto","texto":"DIRETORIA COLEGIADA","ordem":17,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b18","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b18","rotulo":"Texto","texto":"RESOLUÇÃO - RDC Nº 21, DE 20 DE MAIO DE 2009","ordem":18,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b19","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b19","rotulo":"Texto","texto":"Altera o item 2.7, do Anexo III, da Resolução RDC Nº 67, de 8 de outubro de 2007.","ordem":19,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b20","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b20","rotulo":"Texto","texto":"A Diretoria Colegiada da Agência Nacional de Vigilância Sanitária, no uso da atribuição que lhe confere o inciso IV do art. 11 do Regulamento da ANVISA aprovado pelo Decreto Nº 3.029, de 16 de abril de 1999, e tendo em vista o disposto no inciso II e nos §§ 1º e 3º do art. 54 do Regimento Interno aprovado nos termos do Anexo I da Portaria Nº 354 da ANVISA, de 11 de agosto de 2006, republicada no DOU de 21 de agosto de 2006, em reunião realizada em 12 de maio de 2009;","ordem":20,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::bloco::b21","norma":"RDC 21-2009","anexo":null,"tipo":"bloco","numero":"b21","rotulo":"Texto","texto":"Adota a seguinte Resolução da Diretoria Colegiada e eu, Diretor-Presidente, determino a sua publicação.","ordem":21,"estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::artigo::1","norma":"RDC 21-2009","anexo":null,"tipo":"artigo","numero":"1","rotulo":"Art. 1","texto":"Art. 1º O item 2.7. do","ordem":22,"ocorrencia":1,"status_vigencia":"alterador"},{"id":"rdc-21-2009::anexo-iii::anexo::iii","norma":"RDC 21-2009","anexo":"III","tipo":"anexo","numero":"III","rotulo":"Anexo III","texto":"da Resolução - RDC nº 67, de 8 de outubro de 2007","ordem":23,"status_vigencia":"alterador"},{"id":"rdc-21-2009::anexo-iii::bloco::b24","norma":"RDC 21-2009","anexo":"III","tipo":"bloco","numero":"b24","rotulo":"Texto","texto":"que dispõe sobre Boas Práticas de Manipulação de Antibióticos, Hormônios, Citostáticos e Substâncias Sujeitas a Controle Especial passa a vigorar com a seguinte redação:","ordem":24,"pai":"rdc-21-2009::anexo-iii::anexo::iii","estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::anexo-iii::bloco::b25","norma":"RDC 21-2009","anexo":"III","tipo":"bloco","numero":"b25","rotulo":"Texto","texto":"\"ANEXO III","ordem":25,"pai":"rdc-21-2009::anexo-iii::anexo::iii","estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::anexo-iii::bloco::b26","norma":"RDC 21-2009","anexo":"III","tipo":"bloco","numero":"b26","rotulo":"Texto","texto":"BOAS PRÁTICAS DE MANIPULAÇÃO DE HORMÔNIOS, ANTIBIÓTICOS, CITOSTÁTICOS E SUBSTÂNCIAS SUJEITAS A CONTROLE ESPECIAL","ordem":26,"pai":"rdc-21-2009::anexo-iii::anexo::iii","estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::anexo-iii::anexo::iii::item::2-7","norma":"RDC 21-2009","anexo":"III","tipo":"item","numero":"2.7","rotulo":"Item 2.7","texto":"2.7. As farmácias devem possuir salas de manipulação dedicadas, dotadas cada uma com antecâmara, para a manipulação de cada uma das três classes terapêuticas a seguir - hormônios, antibióticos e citostáticos, com sistemas de ar independentes e de eficiência comprovada.","ordem":27,"pai":"rdc-21-2009::anexo-iii::anexo::iii","status_vigencia":"alterador"},{"id":"rdc-21-2009::anexo-iii::anexo::iii::item::2-7-1","norma":"RDC 21-2009","anexo":"III","tipo":"item","numero":"2.7.1","rotulo":"Item 2.7.1","texto":"2.7.1. Para fins de atendimento às disposições deste Anexo, é permitida a manipulação de medicamentos à base de hormônios, antibióticos e citostáticos, em formas líquidas de uso interno, nas salas correspondentes de que trata o item 2.7.","ordem":28,"pai":"rdc-21-2009::anexo-iii::anexo::iii","status_vigencia":"alterador"},{"id":"rdc-21-2009::anexo-iii::anexo::iii::item::2-7-2","norma":"RDC 21-2009","anexo":"III","tipo":"item","numero":"2.7.2","rotulo":"Item 2.7.2","texto":"2.7.2. Tais salas devem possuir pressão negativa em relação às áreas adjacentes, sendo projetadas de forma a impedir o lançamento de pós no laboratório ou no meio ambiente, evitando contaminação cruzada, protegendo o manipulador e o meio ambiente.","ordem":29,"pai":"rdc-21-2009::anexo-iii::anexo::iii","status_vigencia":"alterador"},{"id":"rdc-21-2009::anexo-iii::anexo::iii::item::2-7-3","norma":"RDC 21-2009","anexo":"III","tipo":"item","numero":"2.7.3","rotulo":"Item 2.7.3","texto":"2.7.3. As farmácias que adotarem as condições abaixo especificadas estão isentas da utilização das antecâmaras de que trata o item 2.7.","ordem":30,"pai":"rdc-21-2009::anexo-iii::anexo::iii","status_vigencia":"alterador"},{"id":"rdc-21-2009::anexo-iii::anexo::iii::item::2-7-3-1","norma":"RDC 21-2009","anexo":"III","tipo":"item","numero":"2.7.3.1","rotulo":"Item 2.7.3.1","texto":"2.7.3.1. Salas dedicadas com cabine sem recirculação com exaustão de 100% em área externa à sala, sendo que esta deve possuir filtração que elimine partículas e gases provenientes da manipulação, considerando pressão negativa no interior da cabine. A sala onde esta instalada a cabine deve ter pressão negativa em relação à área adjacente a ela.","ordem":31,"pai":"rdc-21-2009::anexo-iii::anexo::iii","status_vigencia":"alterador"},{"id":"rdc-21-2009::anexo-iii::anexo::iii::item::2-7-3-2","norma":"RDC 21-2009","anexo":"III","tipo":"item","numero":"2.7.3.2","rotulo":"Item 2.7.3.2","texto":"2.7.3.2. Salas dedicadas com cabine de contenção máxima (isolador), totalmente fechada, com ventilação própria, à prova de escape de ar operando com pressão negativa. O trabalho se efetua com luvas de borracha pressas a cabine. Para purificar o ar devem ser instalados filtros HEPA em série ou um filtro HEPA e um incinerador.\"","ordem":32,"pai":"rdc-21-2009::anexo-iii::anexo::iii","status_vigencia":"alterador"},{"id":"rdc-21-2009::anexo-iii::artigo::2","norma":"RDC 21-2009","anexo":"III","tipo":"artigo","numero":"2","rotulo":"Art. 2","texto":"Art. 2º Esta Resolução entra em vigor na data de sua publicação.","ordem":33,"ocorrencia":1,"status_vigencia":"alterador"},{"id":"rdc-21-2009::anexo-iii::bloco::b34","norma":"RDC 21-2009","anexo":"III","tipo":"bloco","numero":"b34","rotulo":"Texto","texto":"DIRCEU RAPOSO DE MELLO","ordem":34,"pai":"rdc-21-2009::anexo-iii::artigo::2","estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::anexo-iii::bloco::b35","norma":"RDC 21-2009","anexo":"III","tipo":"bloco","numero":"b35","rotulo":"Texto","texto":"PUB D.O.U., 21/05/2009 - Seção 1","ordem":35,"pai":"rdc-21-2009::anexo-iii::artigo::2","estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::anexo-iii::bloco::b36","norma":"RDC 21-2009","anexo":"III","tipo":"bloco","numero":"b36","rotulo":"Texto","texto":"Este texto não substitui a Publicação Oficial.","ordem":36,"pai":"rdc-21-2009::anexo-iii::artigo::2","estrutural":false,"status_vigencia":"alterador"},{"id":"rdc-21-2009::anexo-iii::bloco::b37","norma":"RDC 21-2009","anexo":"III","tipo":"bloco","numero":"b37","rotulo":"Texto","texto":"Carregando...","ordem":37,"pai":"rdc-21-2009::anexo-iii::artigo::2","estrutural":false,"status_vigencia":"alterador"}],"validacao":{"ids_estruturais_repetidos":[],"artigos_repetidos_na_fonte":{}},"proveniencia":{"norma":"RDC 21-2009","fonte_oficial":"https://anvisalegis.datalegis.net/action/ActionDatalegis.php?acao=abrirTextoAto&cod_menu=8542&cod_modulo=310&link=S&numeroAto=00000021&orgao=RDC/DC/ANVISA/MS&seqAto=000&tipo=RDC&valorAno=2009","url_final":"https://anvisalegis.datalegis.net/action/ActionDatalegis.php?acao=abrirTextoAto&cod_menu=8542&cod_modulo=310&link=S&numeroAto=00000021&orgao=RDC/DC/ANVISA/MS&seqAto=000&tipo=RDC&valorAno=2009","consultado_em":"2026-09-16T23:59:26.293524+00:00","data_fonte":"2009-05-20","tipo_data_fonte":"data_do_ato; texto consultado no AnvisaLegis","sha256_fonte":"71e20a106341df8ed1fd0576c804fb4cea8a38ef5225c708f971a73175c7d981","sha256_texto":"e25514901b9b17d7000384b3a93e0c37f3192c5a43804d9d4729949623eec253","alteracoes_encontradas":[],"status_vigencia":"alterador","texto":"textos/RDC 21-2009--oficial.txt","data_processamento":"2026-09-16T23:59:26.293524+00:00","schema":"proveniencia-legislativa-v1","estruturar_alineas":true,"escopo_validacao":"texto integral e anexos obtidos do AnvisaLegis; validação estrutural específica para Farmácia de Manipulação","extracao":{"codificacao":"windows-1252","elementos_removidos":18},"classificacao_anvisalegis":"Alterador","classificacao_fonte":"AnvisaLegis"}}