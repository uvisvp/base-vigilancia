  "sha256_texto": "20106924d09deb2d1730e751b3ce5e2a385e333e9d22ced755a6fa08742ad912",
  "nos": [
    {
      "id": "in-96-2021::bloco::b1",
      "norma": "IN 96-2021",
      "anexo": null,
      "tipo": "bloco",
      "numero": "b1",
      "rotulo": "Texto",
      "texto": "INSTRUÇÃO NORMATIVA - IN N° 96, DE 27 DE MAIO DE 2021 (*)",
      "ordem": 1,
      "estrutural": false,
      "status_vigencia": "vigente"
    },
    {
      "id": "in-96-2021::bloco::b2",
      "norma": "IN 96-2021",
      "anexo": null,
      "tipo": "bloco",
      "numero": "b2",
      "rotulo": "Texto",
      "texto": "Dispõe sobre requisitos sanitários para a garantia da qualidade e da segurança em sistemas de ultrassom diagnóstico ou terapêutico, e dá outras providências.",
      "ordem": 2,
      "estrutural": false,
      "status_vigencia": "vigente"
    },
    {
      "id": "in-96-2021::bloco::b3",
      "norma": "IN 96-2021",
      "anexo": null,
      "tipo": "bloco",
      "numero": "b3",
      "rotulo": "Texto",
      "texto": "A Diretoria Colegiada da Agência Nacional de Vigilância Sanitária, no uso das atribuições que lhe confere o art. 15, III e IV, aliado ao art. 7º, III e IV da Lei nº 9.782, de 26 de janeiro de 1999, e ao art. 53, VII, §§ 1º e 3º, do Regimento Interno aprovado pela Resolução de Diretoria Colegiada - RDC nº 255, de 10 de dezembro de 2018, resolve adotar a seguinte Instrução Normativa, conforme deliberado em reunião realizada em 26 de maio de 2021, e eu, Diretor-Presidente, determino a sua publicação.",
      "ordem": 3,
      "estrutural": false,
      "status_vigencia": "vigente"
    },
    {
      "id": "in-96-2021::bloco::b4",
      "norma": "IN 96-2021",
      "anexo": null,
      "tipo": "bloco",
      "numero": "b4",
      "rotulo": "Texto",
      "texto": "CAPÍTULO I",
      "ordem": 4,
      "estrutural": false,
      "status_vigencia": "vigente"
    },
    {
      "id": "in-96-2021::bloco::b5",
      "norma": "IN 96-2021",
      "anexo": null,
      "tipo": "bloco",
      "numero": "b5",
      "rotulo": "Texto",
      "texto": "DISPOSIÇÕES INICIAIS",
      "ordem": 5,
      "estrutural": false,
      "status_vigencia": "vigente"
    },
    {
      "id": "in-96-2021::artigo::1",
      "norma": "IN 96-2021",
      "anexo": null,
      "tipo": "artigo",
      "numero": "1",
      "rotulo": "Art. 1",
      "texto": "Art. 1º Esta Instrução Normativa estabelece requisitos sanitários para a garantia da qualidade e da segurança nos sistemas de ultrassom diagnóstico ou terapêutico, bem como a relação de testes de aceitação e de controle de qualidade que devem ser realizados pelos serviços de saúde, determinando as respectivas periodicidades e tolerâncias, conforme o Anexo desta Instrução Normativa.",
      "ordem": 6,
      "ocorrencia": 1,
      "status_vigencia": "vigente"
    },
    {
      "id": "in-96-2021::artigo::1::paragrafo::unico",
      "norma": "IN 96-2021",
      "anexo": null,
      "tipo": "paragrafo",
      "numero": "unico",
      "rotulo": "Parágrafo único",
      "texto": "Parágrafo único. O rol de testes do Anexo desta Instrução Normativa deve ser complementado pelos testes de aceitação e de controle de qualidade estabelecidos pelo fabricante do sistema avaliado.",
      "ordem": 7,
      "pai": "in-96-2021::artigo::1",
      "status_vigencia": "vigente"
    },
    {
      "id": "in-96-2021::artigo::2",
      "norma": "IN 96-2021",
      "anexo": null,
      "tipo": "artigo",
      "numero": "2",
      "rotulo": "Art. 2",
      "texto": "Art. 2º Os testes de controle de qualidade do equipamento de ultrassom terapêutico devem ser realizados conforme estabelecido pelo fabricante do equipamento.",
      "ordem": 8,
      "ocorrencia": 1,
      "status_vigencia": "vigente"
    },
    {
      "id": "in-96-2021::bloco::b9",
      "norma": "IN 96-2021",
      "anexo": null,
      "tipo": "bloco",
      "numero": "b9",
      "rotulo": "Texto",
      "texto": "CAPÍTULO II",
      "ordem": 9,
      "pai": "in-96-2021::artigo::2",
      "estrutural": false,
      "status_vigencia": "vigente"
    },
    {
      "id": "in-96-2021::bloco::b10",
      "norma": "IN 96-2021",
      "anexo": null,
      "tipo": "bloco",
      "numero": "b10",
      "rotulo": "Texto",
      "texto": "DISPOSIÇÕES FINAIS E TRANSITÓRIAS",
      "ordem": 10,
      "pai": "in-96-2021::artigo::2",
      "estrutural": false,
      "status_vigencia": "vigente"
    },
    {
      "id": "in-96-2021::artigo::3",
      "norma": "IN 96-2021",
      "anexo": null,
      "tipo": "artigo",
      "numero": "3",
      "rotulo": "Art. 3",
      "texto": "Art. 3º Os serviços de saúde abrangidos por esta Instrução Normativa dispõe do prazo de até o dia 26 de dezembro de 2021 para se adequarem ao disposto nesta Instrução Normativa.",
      "ordem": 11,
      "ocorrencia": 1,
      "status_vigencia": "vigente"
    },
    {
      "id": "in-96-2021::artigo::4",
      "norma": "IN 96-2021",
      "anexo": null,
      "tipo": "artigo",
      "numero": "4",
      "rotulo": "Art. 4",
      "texto": "Art. 4º Fica revogada a Instrução Normativa - IN nº 58, de 20 de dezembro de 2019, publicada no Diário Oficial da União n° 249, de 26 de dezembro de 2019, Seção 1, pág. 132.",
      "ordem": 12,
      "ocorrencia": 1,
      "status_vigencia": "vigente"
    },
    {
      "id": "in-96-2021::artigo::5",
      "norma": "IN 96-2021",
      "anexo": null,
      "tipo": "artigo",
      "numero": "5",
      "rotulo": "Art. 5",
      "texto": "Art. 5º Esta Instrução Normativa entra em vigor na data de sua publicação.",
      "ordem": 13,
      "ocorrencia": 1,
      "status_vigencia": "vigente"
    },
